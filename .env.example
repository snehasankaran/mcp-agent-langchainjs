# Jira (Cloud)
JIRA_BASE_URL="https://your-domain.atlassian.net"
JIRA_API_BASE_URL="https://your-domain.atlassian.net/rest/api/3"
JIRA_EMAIL="you@example.com"
JIRA_API_TOKEN="__set_me__"

# MCP endpoints (local)
JIRA_MCP_URL="http://localhost:3000/mcp"
ARTIFACT_MCP_URL="http://localhost:3001/mcp"

# Local RAG paths (local-only docs live under ./data, gitignored)
RAG_DATA_DIR="./data"
RAG_SAMPLE_DATA_DIR="./data.sample"
RAG_INDEX_DIR="./.rag"

# Ollama embeddings (Quest 3)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDINGS_MODEL="nomic-embed-text:latest"

# Foundry Local model aliases (Quest 1)
FOUNDRY_REFINER_MODEL_ALIAS="phi-3.5-mini"
FOUNDRY_SENTINEL_MODEL_ALIAS="phi-3.5-mini"
