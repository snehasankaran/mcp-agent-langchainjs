# Jira (Cloud)
JIRA_BASE_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="you@example.com"
JIRA_API_TOKEN="__set_me__"
JIRA_PROJECT_KEY="AP"
# Optional: override auto-detected story points field ID
# JIRA_STORY_POINTS_FIELD_ID="customfield_10016"

# MCP endpoints (local)
BURGER_MCP_URL="http://localhost:3000/mcp"
JIRA_MCP_URL="http://localhost:3001/mcp"

# Local RAG paths (local-only docs live under ./data, gitignored)
RAG_DATA_DIR="./data"
RAG_SAMPLE_DATA_DIR="./data.sample"
RAG_INDEX_DIR="./.rag"

# Ollama embeddings (Quest 3)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDINGS_MODEL="nomic-embed-text:latest"

# Foundry Local / OpenAI-compatible LLM endpoint (--llm local)
LOCAL_OPENAI_BASE_URL="http://localhost:5273/v1"
LOCAL_OPENAI_MODEL="phi-3.5-mini"
# LOCAL_OPENAI_API_KEY="local"

# Azure OpenAI (--llm azure)
# AZURE_OPENAI_API_ENDPOINT="https://your-resource.openai.azure.com"
# AZURE_OPENAI_MODEL="gpt-4o"
